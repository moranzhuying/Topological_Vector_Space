\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{./structure}[2026/08/24 Personal document structure]

% ================================================================
% structure.sty — 数学笔记模板核心样式包
% ================================================================
% 由 main.tex 通过 \usepackage{./structure} 加载（须用 XeLaTeX 编译）。
%
% 模块划分：
%   I.   页面与基础设置
%   II.  宏包加载（数学 / 绘图 / 表格 / 列表）
%   III. 章节标题与页眉页脚
%   IV.  定理与证明环境（tcolorbox）
%   V.   引用与超链接（hyperref + cleveref）
%   VI.  数学符号定义库
%
% 注意：各宏包加载顺序存在依赖关系，请勿随意调整。
% ================================================================


% ================================================================
% [模块 I] 页面与基础设置
% ================================================================

% -------- 1.1 页面布局 (geometry) --------
% A4 纸张，左右 1.5cm、上下 2cm 边距，单倍行距。
\usepackage{geometry}
\geometry{a4paper, left=1.5cm, right=1.5cm, top=2cm, bottom=2cm}
\linespread{1}

% -------- 1.2 英文字体 (fontspec) --------
% 英文正文字体：默认 Latin Modern（Computer Modern 系，等号无衬线，
% \implies 等长双线箭头渲染为标准几何风格）。
% 中文由 ctexbook 自动处理；数学字体由 amsmath/amssymb 提供，此处不改动。
% 注意：若改用 Times 风格字体（如 TeX Gyre Termes），其等号带衬线，
% 会使 \implies 等长双线箭头左端出现细黑线。

% -------- 1.3 基础宏包 --------
\usepackage{color}     % 颜色支持（\color、\colorbox 等）
\usepackage{bm}        % 粗体数学符号（\bm）


% ================================================================
% [模块 II] 宏包加载
% ================================================================

% -------- 2.1 数学核心宏包 --------
% amsmath      ：基本数学环境（equation / align / gather 等）
% amsfonts     ：数学字体（\mathbb 等）
% amssymb      ：扩展数学符号集
% amsthm       ：定理环境基础
% mathrsfs     ：花体字母（\mathscr）
% stmaryrd     ：扩展数学符号（\bigboxplus 等）
% mathtools    ：amsmath 的增强（\coloneqq 等）
\usepackage{amsmath, amsfonts, amssymb, amsthm}
\usepackage{mathrsfs, stmaryrd, mathtools}

% -------- 2.2 绘图与交换图 --------
% tikz       ：通用绘图引擎
% tikz-cd    ：交换图（配合 quiver.sty 使用 q.uiver.app 导出的图）
% graphicx   ：插图（\includegraphics）
\usepackage{tikz}
\usepackage{tikz-cd}
\usepackage{graphicx}

% -------- 2.3 表格增强宏包 --------
% longtable  ：跨页长表格
% array      ：表格列格式扩展（m{...} 等）
% tabularx   ：自适应宽度表格（X 列）
% multirow   ：跨行合并单元格（\multirow）
% booktabs   ：三线表（\toprule / \midrule / \bottomrule）
% caption    ：图表标题自定义
% subcaption ：子图 / 子表环境（subfigure）
\usepackage{longtable}
\usepackage{array}
\usepackage{tabularx}
\usepackage{multirow}
\usepackage{booktabs}
\usepackage{caption}
\usepackage{subcaption}

% -------- 2.4 行距与数据绘图 --------
% setspace   ：行距控制（\setstretch 等）
% pgfplots   ：基于 TikZ 的高质量数据绘图（\addplot 等）
\usepackage{setspace}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}

% -------- 2.5 列表环境 (enumitem) --------
% 定制 enumerate / itemize 的标签格式（逐级区分）。
\usepackage{enumerate}
\usepackage{enumitem}
\setlist[enumerate,1]{label=(\arabic*)}      % 一级编号：(1)(2)(3)
\setlist[itemize,1]{label=$\diamond$}        % 一级：◆
\setlist[itemize,2]{label=$\triangleright$}  % 二级：▷
\setlist[itemize,3]{label=$\ast$}            % 三级：∗


% ================================================================
% [模块 III] 章节标题与页眉页脚
% ================================================================

% -------- 3.1 Chapter / Part 标题 (ctexset) --------
% ctexbook 默认编号行（Chapter 1）用 \huge、标题行用 \Huge，差一号。
% 这里统一为 \Huge，使编号与标题字号一致。
\ctexset{
    chapter = {
        nameformat = \Huge \bfseries,
    },
    part = {
        nameformat = \Huge \bfseries,
    }
}

% -------- 3.2 Section 格式 (titlesec) --------
\usepackage{titlesec}
\titleformat{\section}
{\normalfont\Large\bfseries\raggedright}
{\thesection}
{1em}
{}
\titlespacing{\section}{0pt}{*3.5}{*1.5}

% -------- 3.3 页眉页脚 (fancyhdr) --------
% 页面风格：页码居中于页脚底部，无页眉横线。
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}                       % 清除所有默认设置
\fancyfoot[C]{\thepage}          % 页码置于底部中间
\renewcommand{\headrulewidth}{0pt}  % 去掉页眉横线


% ================================================================
% [模块 IV] 定理与证明环境 (tcolorbox)
% ================================================================
\usepackage[most]{tcolorbox}     % tcolorbox 全功能加载

% -------- 4.1 旧环境清理 --------
% 将可能与 tcolorbox 重名的环境先重置，避免与已有宏包定义冲突。
\let\comment\relax
\let\endcomment\relax
\let\problem\relax
\let\answer\relax
\let\hint\relax
\let\endhint\relax
\let\sketch\relax
\let\proof\relax
\let\endproof\relax
\let\algorithm\relax
\let\endalgorithm\relax
\let\code\relax
\let\endcode\relax
\let\convention\relax
\let\endconvention\relax
\let\alarm\relax
\let\endalarm\relax

% -------- 4.2 颜色体系 --------
% 高区分度学术配色：每种环境一个主色，用于标题与顶边线；
% 盒子背景使用对应颜色的浅色混合（如 mainblue!6!white）。
\definecolor{mainblue}{RGB}{25, 95, 170}       % 蓝：定义
\definecolor{mainindigo}{RGB}{65, 75, 160}     % 靛蓝：公理/元定理
\definecolor{mainteal}{RGB}{0, 125, 140}       % 青：假设/问题
\definecolor{mainred}{RGB}{180, 45, 55}        % 红：定理/警告
\definecolor{mainorange}{RGB}{210, 100, 25}    % 橙：引理/算法
\definecolor{mainpurple}{RGB}{115, 70, 155}    % 紫：命题/分析
\definecolor{maingreen}{RGB}{40, 125, 75}      % 绿：推论/例
\definecolor{mainbrown}{RGB}{145, 90, 45}      % 茶：准则/约定
\definecolor{mainyellow}{RGB}{195, 135, 0}     % 黄：提示/注意
\definecolor{mainmagenta}{RGB}{190, 55, 95}    % 品红：习题
\definecolor{maingray}{RGB}{80, 80, 80}        % 灰：证明/回答/注记/代码
\definecolor{lightgray}{RGB}{245, 245, 245}    % 浅灰背景

% -------- 4.3 统一计数器 --------
% 所有定理环境共用 mathcount 计数器，按 chapter 编号（如 1.1、1.2、...）。
\newcounter{mathcount}[chapter]
\renewcommand{\themathcount}{\thechapter.\arabic{mathcount}}

% 习题环境使用独立计数器 exercisecount，同样按 chapter 编号（如 2.1、2.2、...），
% 与定理环境（mathcount）互不干扰。
\newcounter{exercisecount}[chapter]
\renewcommand{\theexercisecount}{\thechapter.\arabic{exercisecount}}

% -------- 4.4 基础样式 base_thmstyle --------
% 所有 tcolorbox 环境的公共视觉样式：无框、可跨页、标题黑体无衬线等。
\tcbset{
	base_thmstyle/.style={
		enhanced, breakable, sharp corners, boxrule=0pt, frame hidden,
		attach title to upper={\par\nopagebreak\smallskip},
		fonttitle=\bfseries\sffamily,
		description font=\bfseries\sffamily,
		separator sign={},
		label separator={},
		description delimiters={}{},
		left=2pt, right=2pt, top=8pt, bottom=5pt,
		before skip=1.5em, after skip=1.5em,
	},
	accent north/.style={borderline north={1.8pt}{0pt}{#1}},
	accent west/.style={borderline west={1.8pt}{0pt}{#1}}
}

% -------- 4.5 编号定理环境 (newtcbtheorem) --------
% 用法：\begin{环境名}{标题}{label} ... \end{环境名}
% 编号共用 mathcount，可用 \autoref / \cref 引用（label 参数）。

% -- 4.5.1 基础陈述：蓝、靛蓝、青 --
\newtcbtheorem[use counter=mathcount, number within=chapter]{definition}{定义}{
base_thmstyle, label type=definition, colback=mainblue!6!white, accent north=mainblue, coltitle=mainblue }{def:}
\newtcbtheorem[use counter from=definition]{axiom}{公理}{
base_thmstyle, label type=axiom, colback=mainindigo!7!white, accent north=mainindigo, coltitle=mainindigo }{axi:}
\newtcbtheorem[use counter from=definition]{hypothesis}{假设}{
base_thmstyle, label type=hypothesis, colback=mainteal!7!white, accent north=mainteal, coltitle=mainteal }{hypo:}

% -- 4.5.2 推演结果：每类独立主色，便于快速辨认 --
\newtcbtheorem[use counter from=definition]{theorem}{定理}{
base_thmstyle, label type=theorem, colback=mainred!6!white, accent north=mainred, coltitle=mainred }{thm:}
\newtcbtheorem[use counter from=definition]{lemma}{引理}{
base_thmstyle, label type=lemma, colback=mainorange!8!white, accent north=mainorange, coltitle=mainorange }{lem:}
\newtcbtheorem[use counter from=definition]{proposition}{命题}{
base_thmstyle, label type=proposition, colback=mainpurple!7!white, accent north=mainpurple, coltitle=mainpurple }{prop:}
\newtcbtheorem[use counter from=definition]{corollary}{推论}{
base_thmstyle, label type=corollary, colback=maingreen!7!white, accent north=maingreen, coltitle=maingreen }{cor:}
\newtcbtheorem[use counter from=definition]{metatheorem}{元定理}{
	base_thmstyle, label type=metatheorem, colback=mainindigo!7!white, accent north=mainindigo, coltitle=mainindigo }{metathm:}
\newtcbtheorem[use counter from=definition]{criteria}{准则}{
base_thmstyle, label type=criteria, colback=mainbrown!8!white, accent north=mainbrown, coltitle=mainbrown }{crit:}

% -- 4.5.3 补充说明：问题、例、注记 --
\newtcbtheorem[use counter from=definition]{problem}{问题}{
base_thmstyle, label type=problem, colback=mainyellow!8!white, accent north=mainyellow, coltitle=mainbrown }{prob:}
\newtcbtheorem[use counter from=definition]{example}{例}{
base_thmstyle, label type=example, colback=maingreen!6!white, accent north=maingreen, coltitle=maingreen }{ex:}
\newtcbtheorem[use counter from=definition]{remark}{注记}{
base_thmstyle, label type=remark, colback=maingray!6!white, accent north=maingray, coltitle=maingray }{rmk:}

% -- 4.5.4 习题：独立编号（exercisecount），品红醒目配色 --
% 习题集用环境，编号独立于定理环境（习题 2.1、2.2、...），
% 品红配色使其在正文中一目了然。
\newtcbtheorem[use counter=exercisecount, number within=chapter]{exercise}{习题}{
base_thmstyle, label type=exercise, colback=mainmagenta!8!white, accent north=mainmagenta, coltitle=mainmagenta }{exer:}

% -- 4.5.5 其他：算法、约定、警示（均与定理环境共用编号） --
\newtcbtheorem[use counter from=definition]{algorithm}{算法}{
base_thmstyle, label type=algorithm, colback=mainorange!8!white, accent north=mainorange, coltitle=mainorange }{algo:}
\newtcbtheorem[use counter from=definition]{convention}{约定}{
base_thmstyle, label type=convention, colback=mainbrown!8!white, accent north=mainbrown, coltitle=mainbrown }{conv:}
\newtcbtheorem[use counter from=definition]{alarm}{警示}{
base_thmstyle, label type=alarm, colback=mainyellow!16!white, accent north=mainred, coltitle=mainred }{alarm:}

% -------- 4.6 证明 / 回答 / 提示 / 代码环境 --------

% -- 4.6.1 证明：灰色顶线，自动加证毕符号（∎） --
\newtcolorbox{proof}{
	base_thmstyle,
	title={证明},
	coltitle=maingray,
	accent north=maingray!50,
	colback=white,
	after upper={\hfill $\square$} % 自动加证明完毕符号
}

% -- 4.6.2 回答：灰色顶线 --
\newtcolorbox{answer}{
	base_thmstyle,
	title={回答},
	coltitle=maingray,
	accent north=maingray!30,
	colback=white!2!white
}

% -- 4.6.3 解答：灰色细线，题后即答（习题专用） --
% 用法：\begin{exercise}{...}{...} 题目 \end{exercise}
%      紧接 \begin{solution} 解答内容 \end{solution}
% 无编号、白底、细顶线，视觉轻于定理环境；before skip 较小使其紧贴题目。
\newtcolorbox{solution}{
	base_thmstyle,
	title={解答},
	coltitle=maingray,
	accent north=maingray!30,
	colback=white,
	before skip=0.6em,
	after skip=1.5em
}

% -- 4.6.4 分析：带编号（与定理环境共用计数器） --
\newtcbtheorem[use counter from=definition]{sketch}{分析}{
base_thmstyle, label type=sketch, colback=mainpurple!5!white, accent north=mainpurple!70, coltitle=mainpurple }{sketch:}

% -- 4.6.5 提示：正文可自然换行、分段和跨页 --
\newtcolorbox{hint}[1][提示]{
	base_thmstyle,
	title={#1},
	coltitle=mainbrown,
	colback=mainyellow!10!white,
	accent west=mainyellow,
	left=8pt,
	top=5pt
}

% -- 4.6.6 代码：可换行、可跨页的代码块；可选参数作为标题 --
% 用法：\begin{code}[Python 示例] ... \end{code}
\newtcblisting{code}[1][]{
	enhanced, breakable, listing only,
	sharp corners, boxrule=0pt, frame hidden,
	colback=maingray!6!white,
	accent west=maingray,
	title={\ifstrempty{#1}{代码}{代码：#1}},
	fonttitle=\bfseries\sffamily,
	coltitle=maingray,
	left=8pt, right=5pt, top=5pt, bottom=5pt,
	before skip=1.5em, after skip=1.5em,
	listing options={
		basicstyle=\ttfamily\small,
		breaklines=true,
		columns=fullflexible,
		keepspaces=true,
		showstringspaces=false
	}
}


% ================================================================
% [模块 V] 引用与超链接 (hyperref + cleveref)
% ================================================================

% -------- 5.1 hyperref 设置 --------
\usepackage{hyperref}
% PDF 书签（侧边栏）显示章节编号：\numberline 在书签里展开为「编号+空格」
\pdfstringdefDisableCommands{%
  \def\numberline#1{#1~}%
}
\hypersetup{
	colorlinks=true,         % 开启链接颜色
	linkcolor=mainblue,      % 内部链接颜色（目录、公式引用等）
	citecolor=mainblue,      % 文献引用颜色
	filecolor=magenta,       % 文件链接颜色
	urlcolor=mainblue,       % 外部网址颜色
}
\renewcommand{\figureautorefname}{图}
\renewcommand{\tableautorefname}{表}

% -------- 5.2 定理环境引用名称 --------
% tcolorbox 定理环境的 \autoref 名称（与盒子视觉样式无关）。
% 所有这类环境共用 mathcount 计数器，hyperref 实际查询的是该计数器名。
\providecommand{\mathcountautorefname}{定理}
\providecommand{\definitionautorefname}{定义}
\providecommand{\axiomautorefname}{公理}
\providecommand{\hypothesisautorefname}{假设}
\providecommand{\theoremautorefname}{定理}
\providecommand{\lemmaautorefname}{引理}
\providecommand{\propositionautorefname}{命题}
\providecommand{\corollaryautorefname}{推论}
\providecommand{\metatheoremautorefname}{元定理}
\providecommand{\criteriaautorefname}{准则}
\providecommand{\problemautorefname}{问题}
\providecommand{\exerciseautorefname}{习题}
\providecommand{\exampleautorefname}{例}
\providecommand{\remarkautorefname}{注记}
\providecommand{\sketchautorefname}{分析}
\providecommand{\algorithmautorefname}{算法}
\providecommand{\conventionautorefname}{约定}
\providecommand{\alarmautorefname}{警示}

% -------- 5.3 cleveref 智能引用 --------
% nameinlink：链接包含引用名（如「定理 1.1」整体可点击）。
\usepackage[nameinlink]{cleveref}

% -- 5.3.1 英文引用名（备用） --
\crefname{definition}{Definition}{Definitions}
\crefname{theorem}{Theorem}{Theorems}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{problem}{Problem}{Problems}
\crefname{exercise}{Exercise}{Exercises}
\crefname{algorithm}{Algorithm}{Algorithms}
\crefname{convention}{Convention}{Conventions}
\crefname{alarm}{Alarm}{Alarms}

% -- 5.3.2 中文引用名（默认使用） --
% tcolorbox 环境共用 mathcount 计数器，其类型信息由 cleveref 写入
% @cref 标签。令 \autoref 复用 cleveref，确保每种环境显示自己的名称。
\crefname{definition}{定义}{定义}
\crefname{axiom}{公理}{公理}
\crefname{hypothesis}{假设}{假设}
\crefname{theorem}{定理}{定理}
\crefname{lemma}{引理}{引理}
\crefname{proposition}{命题}{命题}
\crefname{corollary}{推论}{推论}
\crefname{metatheorem}{元定理}{元定理}
\crefname{criteria}{准则}{准则}
\crefname{problem}{问题}{问题}
\crefname{exercise}{习题}{习题}
\crefname{example}{例}{例}
\crefname{remark}{注记}{注记}
\crefname{sketch}{分析}{分析}
\crefname{algorithm}{算法}{算法}
\crefname{convention}{约定}{约定}
\crefname{alarm}{警示}{警示}

% -- 5.3.3 图、表、公式的中文引用名与标题名 --
% （ctexbook scheme=plain 下默认是英文 Figure/Table，这里统一为中文）
\crefname{figure}{图}{图}
\crefname{table}{表}{表}
\crefname{equation}{公式}{公式}
\Crefname{figure}{图}{图}
\Crefname{table}{表}{表}
\Crefname{equation}{公式}{公式}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\renewcommand{\autoref}[1]{\cref{#1}}

% -------- 5.4 多标签引用连接词 --------
% 默认英文 and，改为中文「和」；连续编号范围用「到」。
% 注意：cleveref 的连接词命令延迟初始化，须放在 \AtBeginDocument 中重定义；
% 同类型标签之间用 conjunction，不同类型标签组之间用 groupconjunction，两套都要改。
\AtBeginDocument{
    \renewcommand{\crefpairconjunction}{和}
    \renewcommand{\crefmiddleconjunction}{,}
    \renewcommand{\creflastconjunction}{和}
    \renewcommand{\crefrangeconjunction}{到}
    \renewcommand{\crefpairgroupconjunction}{和}
    \renewcommand{\crefmiddlegroupconjunction}{,}
    \renewcommand{\creflastgroupconjunction}{和}
}

% -------- 5.5 习题引用笔记宏 \noteref --------
% 习题文件中对笔记定理/定义/命题等的引用一律写 \noteref{标签}，两种模式通用：
%   模式 1（独立习题集 ExerciseBook/）：默认行为，跨文档引用笔记标签，
%       配合 \externaldocument[note-]{main} 使用（见习题集 main.tex），
%       展开为 \ref{note-标签}。
%   模式 2（讲义，习题内嵌正文）：在 main.tex 中用
%       \renewcommand{\noteref}[1]{\ref{#1}} 覆盖为本地引用。
% 这样习题文件内容完全可移植：两种模式间转换只需搬目录，引用零修改。
\providecommand{\noteref}[1]{\ref{note-#1}}


% ================================================================
% [模块 VI] 数学符号定义库
% ================================================================
% 常用记号统一预定义，正文中直接使用即可（无需每次写 \operatorname）。

% -------- 6.1 代数 --------
\newcommand{\N}{\mathbb{N}}              % 自然数集
\newcommand{\Z}{\mathbb{Z}}              % 整数集
\newcommand{\Q}{\mathbb{Q}}              % 有理数集
\newcommand{\R}{\mathbb{R}}              % 实数集
\newcommand{\C}{\mathbb{C}}              % 复数集
\newcommand{\K}{\mathbb{K}}              % 域
\newcommand{\F}{\mathbb{F}}              % 有限域
\renewcommand{\emptyset}{\varnothing}    % 空集
\newcommand{\fin}{\operatorname{Fin}}    % 有限
\newcommand{\Coll}{\operatorname{Coll}}  % 集化关系
\newcommand{\FuncRel}{\operatorname{FuncRel}} % 函数关系
\newcommand{\PFunc}{\operatorname{PFunc}} % 偏函数
\newcommand{\Eq}{\operatorname{Eq}}      % 等价关系
\newcommand{\id}{\operatorname{id}}      % 恒等变换
\newcommand{\rank}{\operatorname{rank}}  % 秩
\newcommand{\nul}{\operatorname{nul}}    % 零度
\newcommand{\Nul}{\operatorname{Nul}}    % 零空间
\newcommand{\dom}{\operatorname{dom}}    % 定义域
\newcommand{\im}{\operatorname{im}}      % 像
\newcommand{\coim}{\operatorname{coim}}  % 陪像
\newcommand{\coker}{\operatorname{coker}}% 陪核
\newcommand{\tr}{\operatorname{tr}}      % 模中的迹
\newcommand{\Tr}{\operatorname{Tr}}      % 代数中的迹
\newcommand{\diag}{\operatorname{diag}}  % 对角矩阵
\newcommand{\codim}{\operatorname{codim}}% 余维数
\newcommand{\row}{\operatorname{row}}    % 行空间
\newcommand{\col}{\operatorname{col}}    % 列空间
\newcommand{\Mat}{\mathbf{M}}               % 矩阵空间（与正文 \mathbf{M} 一致）
\newcommand{\am}{\operatorname{AM}}      % 代数重数
\newcommand{\gm}{\operatorname{GM}}      % 几何重数
\newcommand{\Ann}{\operatorname{Ann}}    % 零化子
\newcommand{\Char}{\operatorname{Char}}  % 特征
\newcommand{\Min}{\operatorname{Min}}    % 最小多项式
\newcommand{\piv}{\operatorname{piv}}    % 主元指数
\newcommand{\Hom}{\operatorname{Hom}}    % 态射集
\newcommand{\End}{\operatorname{End}}    % 自同态
